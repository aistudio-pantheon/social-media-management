# Claude API key powers all AI features (caption generation, repurposing, insights).
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Default model for content generation. Options:
#   claude-opus-4-8      (most capable)
#   claude-sonnet-4-6    (fast + smart, recommended default)
#   claude-haiku-4-5     (cheapest/fastest)
AI_MODEL=claude-sonnet-4-6

# --- Platform OAuth (add as you wire up real publishing) ---
